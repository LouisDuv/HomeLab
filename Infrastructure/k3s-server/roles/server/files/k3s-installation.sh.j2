#!/bin/bash

echo "[1/2] K3s installation"
curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server \
    --disable servicelb \
    --write-kubeconfig-mode 644 \
    --node-ip {{ ansible_host }} \
    --node-name master-node \
    --data-dir {{ data_directory }}
" sh -s -

echo "[2/2] Installation is successfull"